.vision-page {
  padding-bottom: 64rpx;
}

.vision-header {
  margin-bottom: 22rpx;
}

.title {
  margin-top: 12rpx;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 900;
}

.subtitle {
  margin-top: 10rpx;
  color: #9faabd;
  font-size: 24rpx;
  line-height: 1.5;
}

.upload-card,
.result-card {
  display: grid;
  gap: 18rpx;
}

.image-preview,
.empty-preview {
  height: 360rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 18rpx;
  background: #0f131b;
}

.image-preview image {
  display: block;
  width: 100%;
  height: 100%;
}

.empty-preview {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-title {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
}

.empty-text {
  margin-top: 8rpx;
  color: #8f99aa;
  font-size: 24rpx;
}

.hint-input {
  width: 100%;
  min-height: 120rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  color: #ffffff;
  background: #0f131b;
  box-sizing: border-box;
  font-size: 24rpx;
  line-height: 1.45;
}

.upload-actions,
.result-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.upload-actions button,
.result-actions button {
  margin: 0;
}

.result-card {
  margin-top: 22rpx;
}

.result-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.result-label {
  color: #9aa4b5;
  font-size: 22rpx;
  font-weight: 700;
}

.result-type {
  margin-top: 6rpx;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
}

.provider-badge {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  color: #82e6a3;
  background: rgba(130, 230, 163, 0.1);
  font-size: 22rpx;
  font-weight: 800;
}

.provider-badge.is-demo {
  color: #f4c96b;
  background: rgba(244, 201, 107, 0.1);
}

.warning-list {
  display: grid;
  gap: 8rpx;
}

.warning-item {
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  color: #f4c96b;
  background: rgba(244, 201, 107, 0.08);
  font-size: 22rpx;
  line-height: 1.45;
}

.parts-title {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
}

.part-card {
  display: grid;
  gap: 14rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  background: #10141d;
}

.part-head {
  display: grid;
  grid-template-columns: 44rpx 1fr;
  gap: 12rpx;
  align-items: center;
}

.part-index {
  color: #f4c96b;
  font-size: 28rpx;
  font-weight: 900;
  text-align: center;
}

.part-name,
.field input,
.wide-field input {
  min-width: 0;
  height: 58rpx;
  padding: 0 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 14rpx;
  color: #ffffff;
  background: #0d1119;
  box-sizing: border-box;
  font-size: 24rpx;
}

.part-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.field-label {
  margin-bottom: 8rpx;
  color: #9aa4b5;
  font-size: 20rpx;
  font-weight: 800;
}

.field input {
  text-align: center;
}

.wide-field input {
  width: 100%;
}

.part-note {
  color: #98a3b5;
  font-size: 22rpx;
  line-height: 1.45;
}
