page {
  min-height: 100vh;
  color: #f5f7fb;
  background: #0c0e12;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.muted {
  color: #9aa3b2;
}

.card {
  padding: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  background: #151922;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.22);
}

.section-title {
  margin: 36rpx 0 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
}

.pill {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(244, 201, 107, 0.25);
  border-radius: 999rpx;
  color: #f4c96b;
  background: rgba(244, 201, 107, 0.09);
  font-size: 22rpx;
}

.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  border-radius: 18rpx;
  color: #15110a;
  background: #f4c96b;
  font-size: 30rpx;
  font-weight: 800;
}

.ghost-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 18rpx;
  color: #f5f7fb;
  background: #161b25;
  font-size: 28rpx;
}

.input,
.select {
  height: 84rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  color: #ffffff;
  background: #0f131b;
  box-sizing: border-box;
  font-size: 28rpx;
}

.label {
  margin: 0 0 12rpx;
  color: #b5bfce;
  font-size: 24rpx;
}

.placeholder {
  color: #606b7b;
}
